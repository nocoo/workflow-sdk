#!/usr/bin/env bash
set -euo pipefail

echo "[pre-commit] S1: Typecheck"
bun run typecheck

echo "[pre-commit] S2: Lint & Format (Biome)"
bun run lint

echo "[pre-commit] L1: Unit Tests & Coverage (95% threshold)"
bun run test:coverage

if command -v gitleaks >/dev/null 2>&1; then
  echo "[pre-commit] G1: Secrets scan (staged)"
  gitleaks protect --staged --no-banner --redact
else
  echo "[pre-commit] G1: gitleaks not installed; running built-in staged pattern check"
  if git diff --cached --diff-filter=ACMR -U0 | grep -E '^\+.*(gho_[A-Za-z0-9]{20,}|sk-[A-Za-z0-9]{20,}|xray_pt_[A-Za-z0-9_-]{20,}|AIza[0-9A-Za-z_-]{30,})' >/dev/null; then
    echo "Error: Potential secret detected in staged changes!" >&2
    exit 1
  fi
fi
